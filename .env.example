# Trading Agent Environment Variables
# Copy this file to .env and fill in your actual values

# ==================== LLM API Keys ====================

# Aliyun DashScope (GLM-5)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://coding.dashscope.aliyuncs.com/v1

# ==================== Feishu Push ====================

FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id

# ==================== Email Push (Optional) ====================

EMAIL_SMTP=smtp.example.com
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_TO=recipient@example.com

# ==================== TrendRadar MCP ====================

# TrendRadar MCP server path (optional)
TRENDRADAR_MCP_PATH=/path/to/TrendRadar/mcp_server

# TrendRadar data directory (optional, for reading news data)
TRENDARAR_DATA_PATH=/path/to/TrendRadar/data

# ==================== Proxy (Optional) ====================

# For akshare if network requires proxy
HTTP_PROXY=
HTTPS_PROXY=